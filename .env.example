# ---------- Chain ----------
# Robinhood Chain mainnet = 4663. Local dev: anvil fork keeps chainId 4663.
NEXT_PUBLIC_CHAIN_ID=4663
# Browser RPC. Empty -> the public Robinhood Chain RPC (rate-limited per visitor IP, fine for the site).
# Local dev: the anvil fork below.
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
RPC_URL_4663=https://rpc.mainnet.chain.robinhood.com

# ---------- Web ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Built-in indexer (web/indexer/): the site syncs the launchpad's logs into DATABASE_URL itself and serves them under /api.
# Optional fallback RPC after the public one (e.g. an Alchemy URL without a domain allowlist).
INDEXER_RPC_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_HERO_LIVE_STATS=false
# TwainLauncher address (overrides packages/shared/src/addresses.ts DEPLOYMENTS). Empty -> prelaunch mode (empty lists).
NEXT_PUBLIC_LAUNCHER=
# L2 block of the launcher deploy transaction (indexer start block)
NEXT_PUBLIC_START_BLOCK=
# Status banner (hidden when empty)
NEXT_PUBLIC_BANNER_ID=
NEXT_PUBLIC_BANNER_TITLE=
NEXT_PUBLIC_BANNER_TEXT=
# Image + metadata storage (Pinata)
PINATA_JWT=
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
# Forum + built-in indexer (Postgres, e.g. Neon). Empty DATABASE_URL -> local PGlite in web/.pglite (or PGLITE_DIR).
DATABASE_URL=
# 32+ random characters (openssl rand -base64 32). Required in production.
SESSION_SECRET=
# Comma-separated wallet addresses that can hide forum posts and comments
FORUM_ADMINS=

# Optional CoinGecko demo key for /api/eth-usd. ETH/USD comes from Coinbase, then Kraken; CoinGecko is the last fallback.
COINGECKO_API_KEY=

# ---------- Contracts deploy (never commit real values) ----------
PROTOCOL_OWNER=
PROTOCOL_TREASURY=
# Optional: assets listed at deploy besides ETH (comma-separated; start market cap in each asset's smallest unit)
ASSET_ADDRESSES=
ASSET_START_MCAPS=

# Built-in indexer in a production build on localhost (demo recordings): read metadata from the local upload store
ALLOW_LOCAL_METADATA=false
